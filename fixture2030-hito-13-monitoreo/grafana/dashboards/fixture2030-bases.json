        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "C",
          "expr": "cassandra_compaction_pending_tasks",
          "legendFormat": "compactaciones"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Cola de trabajo del nodo. Si crece y no baja, Cassandra está saturada: la latencia sube después."
    }
  ]
