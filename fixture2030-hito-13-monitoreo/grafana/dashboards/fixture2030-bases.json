    {
      "id": 105,
      "title": "Alertas de Neo4j e InfluxDB",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 17,
        "y": 36,
        "w": 7,
        "h": 5
      },
      "description": "Alertas en pending o firing que tocan a estas dos bases: las propias (Neo4j*, InfluxDB*) y las generales con base o job neo4j / influxdb. Vacío = sin alertas.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "ALERTS{alertname=~\"Neo4j.*|InfluxDB.*\"} or ALERTS{base=~\"neo4j|influxdb\"} or ALERTS{job=~\"neo4j|influxdb\"}"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "alertname": true,
              "alertstate": true,
              "severidad": true,
              "base": true
            },
            "renameByName": {
              "alertname": "alerta",
              "alertstate": "estado"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "color": "red",
                        "text": "FIRING"
                      },
                      "pending": {
                        "color": "orange",
                        "text": "pending"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
