    {
      "id": 22,
      "title": "Latencia de lectura y escritura (p99)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "cassandra_clientrequest_latency_seconds{operacion=~\"Read|Write\",quantile=\"0.99\"}",
          "legendFormat": "{{operacion}} p99"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "B",
          "expr": "cassandra_clientrequest_latency_seconds{operacion=~\"Read|Write\",quantile=\"0.50\"}",
          "legendFormat": "{{operacion}} p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Latencia vista por el nodo coordinador (no incluye la red ni la API). Los percentiles los calcula Cassandra dando más peso a lo reciente: reaccionan en minutos. Línea roja: 100 ms, umbral experimental."
    },
