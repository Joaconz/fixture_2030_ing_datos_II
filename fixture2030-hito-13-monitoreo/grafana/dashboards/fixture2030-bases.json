        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 19,
      "title": "Hit ratio de la caché",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "rate(redis_keyspace_hits_total[1m]) / clamp_min(rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m]), 1e-9)",
          "legendFormat": "hits / (hits + misses)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 20,
      "title": "Memoria y clientes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "redis_memory_used_bytes",
          "legendFormat": "memoria usada"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "B",
          "expr": "redis_connected_clients",
          "legendFormat": "clientes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "clientes"
            },
            "properties": [
