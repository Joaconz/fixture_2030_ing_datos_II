    {
      "id": 26,
      "title": "Tareas pendientes (escrituras y compactación)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "cassandra_threadpool_pendingtasks{pool=\"MutationStage\"}",
          "legendFormat": "MutationStage (escrituras)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "B",
          "expr": "cassandra_threadpool_pendingtasks{pool=\"ReadStage\"}",
          "legendFormat": "ReadStage (lecturas)"
