{
  "uid": "fixture2030-monitoreo",
  "title": "Fixture 2030 — Monitoreo",
  "tags": [
    "fixture2030",
    "hito13"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Estado de salud",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Estado por target (up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}} {{base}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CAÍDO",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "1 = Prometheus pudo scrapear el target en el último intervalo; 0 = caído. Cuando se agreguen exporters de las bases o la API, aparecen acá solos."
    },
    {
      "id": 3,
      "title": "Targets arriba",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "sum(up)",
          "legendFormat": "arriba"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "B",
          "expr": "count(up)",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "title": "Estado de salud por base",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "max by (base) (probe_success{job=\"salud-bases\"})",
          "legendFormat": "{{base}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CAÍDA",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Sonda del blackbox-exporter contra el puerto publicado de cada base: TCP para MongoDB, Redis y Cassandra; HTTP para Neo4j (7474) e InfluxDB (/health)."
    },
    {
      "id": 34,
      "title": "Alertas activas",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "description": "Reglas de prometheus/reglas-o-alertas.yml que están en pending (condición cumplida, esperando el 'for') o firing. Vacío = sin alertas.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "ALERTS",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "alertname": true,
              "alertstate": true,
              "severidad": true,
              "base": true,
              "job": true
            },
            "renameByName": {
              "alertname": "alerta",
              "alertstate": "estado",
              "severidad": "severidad",
              "base": "base",
              "job": "job"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "color": "red",
                        "text": "FIRING"
                      },
                      "pending": {
                        "color": "orange",
                        "text": "pending"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 27,
      "type": "row",
      "title": "API integrada (Hito 10) — métricas de aplicación",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 28,
      "title": "Requests por segundo según status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "sum by (status) (rate(fixture2030_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Volumen de la API (RF6). Ventana: rate de 1 minuto. 2xx = OK, 4xx = error del cliente, 503/504 = una base no respondió."
    },
    {
      "id": 29,
      "title": "Latencia p95 por ruta",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, ruta) (rate(fixture2030_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ruta}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Tiempo de respuesta medido en la API, incluida la espera a las bases. p95 sobre una ventana de 5 minutos. Línea roja: 150 ms, umbral de la alerta ApiLatenciaAlta (el Hito 12 midió p95 = 82,4 ms bajo carga)."
    },
    {
      "id": 30,
      "title": "Porcentaje de respuestas 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "100 * sum(rate(fixture2030_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(fixture2030_http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Errores del lado del servidor sobre el total, ventana de 5 minutos. Línea roja: 1 %, umbral de la alerta ApiErroresAltos."
    },
