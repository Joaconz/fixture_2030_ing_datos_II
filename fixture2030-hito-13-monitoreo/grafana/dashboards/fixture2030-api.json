{
  "uid": "fixture2030-api",
  "title": "Fixture 2030 — 2. API integrada",
  "description": "Métricas de aplicación de la API del Hito 10 (fixture2030_http_*): tráfico por status, latencia p95 por ruta y porcentaje de 5xx.",
  "tags": [
    "fixture2030",
    "hito13"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "Dashboards del Fixture 2030",
      "type": "dashboards",
      "tags": [
        "fixture2030"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 27,
      "type": "row",
      "title": "API integrada (Hito 10) — métricas de aplicación",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 28,
      "title": "Requests por segundo según status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "sum by (status) (rate(fixture2030_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Volumen de la API (RF6). Ventana: rate de 1 minuto. 2xx = OK, 4xx = error del cliente, 503/504 = una base no respondió."
    },
    {
      "id": 29,
      "title": "Latencia p95 por ruta",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, ruta) (rate(fixture2030_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{ruta}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Tiempo de respuesta medido en la API, incluida la espera a las bases. p95 sobre una ventana de 5 minutos. Línea roja: 150 ms, umbral de la alerta ApiLatenciaAlta (el Hito 12 midió p95 = 82,4 ms bajo carga)."
    },
    {
      "id": 30,
      "title": "Porcentaje de respuestas 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fixture2030"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fixture2030"
          },
          "refId": "A",
          "expr": "100 * sum(rate(fixture2030_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(fixture2030_http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Errores del lado del servidor sobre el total, ventana de 5 minutos. Línea roja: 1 %, umbral de la alerta ApiErroresAltos."
    }
  ]
}
