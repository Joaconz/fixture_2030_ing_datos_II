# ============================================================
#  Fixture 2030 — Hito 11 · Evaluación de la conectividad
#  Configuración de ejemplo (versionada). NINGÚN valor es un secreto.
#
#  Para cambiar algo: copiar a config/configuracion.env (ignorado por git)
#  o exportar la variable en la terminal. Prioridad:
#     variable de entorno  >  config/configuracion.env  >  este archivo
#
#  ORIGEN (RNF3): estos valores son los que usa un proceso que corre EN LA
#  NOTEBOOK, igual que la API del Hito 10 (uvicorn en 127.0.0.1:8000). Desde
#  un contenedor, `localhost` es el propio contenedor: ahí habría que usar el
#  nombre del servicio Compose y el puerto interno (ver docs/topologia_y_entornos.md).
# ============================================================

# --- Entorno de la prueba ------------------------------------
# Texto libre que queda en cada registro de evidencia (no poner datos personales).
ENTORNO=notebook-docker-desktop
# Límites de espera (RNF5), en segundos
CONNECT_TIMEOUT=2
OPERACION_TIMEOUT=3
API_TIMEOUT=8

# --- API del Hito 10 -----------------------------------------
API_URL=http://localhost:8000
# Ruta al módulo de la API (para usar su .venv con los mismos drivers)
API_DIR=../fixture2030-hito10-api

# --- MongoDB (Hito 4) — equipos y jugadores ------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=fixture2030
MONGO_COLECCION=equipos
MONGO_EQUIPO_DEMO=ARG
# Sin autenticación en el laboratorio. Si se agrega, definir MONGO_USER y
# MONGO_PASSWORD sólo en el entorno o en configuracion.env.
MONGO_USER=

# --- Neo4j (Hito 5 + reentrega Hito 3) — partidos, eventos, tipos
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_DATABASE=neo4j
NEO4J_USER=neo4j
# La contraseña NO va acá: se toma de NEO4J_PASSWORD (entorno) o del .env
# local del módulo Neo4j (ignorado por git).
NEO4J_ENV_FILE=../fixture2030-neo4j/.env
NEO4J_PARTIDO_DEMO=PAR-A-1
NEO4J_PARTIDO_SIN_EVENTOS=PAR-D16-01
NEO4J_PARTIDO_INEXISTENTE=PAR-X-99

# --- Cassandra (Hito 6) — comentarios ------------------------
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030_comentarios
CASSANDRA_TABLA=comentarios_por_partido
CASSANDRA_DC=datacenter1
CASSANDRA_PARTIDO_DEMO=PAR-A-1

# --- Redis (Hito 7) — sesiones y caché -----------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_SESION_DEMO=demo-ses-0000001-1
REDIS_PREFIJO_SESION=f30:ses:

# --- InfluxDB 3 Core (Hito 8) — estadísticas en vivo ---------
INFLUX_URL=http://127.0.0.1:8181
INFLUX_DB=fixture2030_vivo
INFLUX_TABLA=estadisticas_equipo
# El token NO va acá: archivo local creado por fixture2030-influxdb/scripts/autorizacion_local.sh
INFLUX_TOKEN_FILE=../fixture2030-influxdb/secrets/admin-token.json
INFLUX_PARTIDO_DEMO=PAR-A-1
INFLUX_DESDE=2030-06-09T13:00:00Z
INFLUX_HASTA=2030-06-09T13:30:00Z

# --- InterSystems IRIS (Hito 9) — fuera de la arquitectura vigente
# 0 = se declara NOT_CONFIGURED y sólo se sondea el puerto para documentar
#     que no hay listener; 1 = se evalúa (requiere `docker compose up -d`
#     en fixture2030-iris y su inicialización).
IRIS_HABILITADO=0
IRIS_HOST=127.0.0.1
IRIS_PORT=1972
IRIS_PORTAL_URL=http://127.0.0.1:52773
IRIS_NAMESPACE=USER
IRIS_CONTAINER=fixture2030-iris
IRIS_CLASE=Fixture.Partido

# --- Contenedores (para clientes nativos vía docker exec y la falla controlada)
MONGO_CONTAINER=fixture2030_mongo
NEO4J_CONTAINER=fixture2030-neo4j
CASSANDRA_CONTAINER=fixture2030-cassandra
REDIS_CONTAINER=fixture2030-redis
INFLUX_CONTAINER=fixture2030-influxdb
