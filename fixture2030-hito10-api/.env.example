# ============================================================
#  Fixture 2030 — Hito 10 · API REST integrada
#  Copiar a .env (ignorado por git) y completar SOLO en la notebook.
#  Ningún valor de este archivo es un secreto real.
# ============================================================
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# Orígenes permitidos (CORS), separados por coma: front local + dominio de Vercel
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Timeout general por operación contra una dependencia (segundos, RNF8)
DEP_TIMEOUT_S=2.0

# Salud (Hito 11): caché del chequeo profundo (s, 0 = sin caché) y fuentes esenciales
# para /health/ready (si alguna no está UP → 503 NO_LISTA)
HEALTH_CACHE_S=5
READY_ESENCIALES=mongodb,neo4j

# MongoDB (Hito 4) — sin autenticación en el laboratorio
MONGO_URI=mongodb://localhost:27017
MONGO_DB=fixture2030

# Neo4j (Hito 5) — misma credencial de desarrollo que fixture2030-neo4j/.env
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Cassandra (Hito 6) — nodo único, sin autenticación
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030_comentarios
CASSANDRA_DC=datacenter1

# Redis (Hito 7) — loopback, sin contraseña, base lógica 0
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_PARTIDO_TTL_S=60

# InfluxDB 3 Core (Hito 8) — el token NO va acá: se lee del archivo local
# que crea fixture2030-influxdb/scripts/autorizacion_local.sh (ignorado por git).
INFLUX_URL=http://127.0.0.1:8181
INFLUX_DB=fixture2030_vivo
INFLUX_TOKEN_FILE=../fixture2030-influxdb/secrets/admin-token.json

# Hito 12 · caché de la configuración de partición de comentarios (segundos; 0 = desactivada)
COMENTARIOS_CONFIG_CACHE_S=0
