# ============================================================================
#  Fixture 2030 — Hito 12 · configuración del escenario (SIN secretos)
#  Para cambiar algo, copiar como config/configuracion.env (ignorado por git).
#  La API toma sus propias credenciales de fixture2030-hito10-api/.env.
# ============================================================================
API_PORT=8000
# URL con la que k6 (en Docker) llega a la API que corre en la notebook
K6_BASE_URL=http://host.docker.internal:8000
# Escenario (RF2): usuarios virtuales, rampa y sostenimiento en segundos
VUS=20
RAMPA_S=30
SOSTEN_S=120
# Optimización (Hito 12): segundos de caché de la configuración Q0 en la prueba optimizada
CACHE_Q0_OPTIMIZADA_S=60
# Imagen del generador de carga (versión fija para que la prueba sea repetible)
K6_IMAGEN=grafana/k6:2.3.0
